<?xml version='1.0' encoding='utf-8'?>
<robot name="theimcbot_urdf">
  <material name="Black">
    <color rgba="0.0 0.0 0.0 1.0" />
  </material>
  <material name="Dark">
    <color rgba="0.3 0.3 0.3 1.0" />
  </material>
  <material name="Light_black">
    <color rgba="0.4 0.4 0.4 1.0" />
  </material>
  <material name="Blue">
    <color rgba="0.0 0.0 0.8 1.0" />
  </material>
  <material name="Green">
    <color rgba="0.0 0.8 0.0 1.0" />
  </material>
  <material name="Grey">
    <color rgba="0.5 0.5 0.5 1.0" />
  </material>
  <material name="Orange">
    <color rgba="1.0 0.423529 0.039216 1.0" />
  </material>
  <material name="Brown">
    <color rgba="0.870588 0.811765 0.764706 1.0" />
  </material>
  <material name="Red">
    <color rgba="0.8 0.0 0.0 1.0" />
  </material>
  <material name="White">
    <color rgba="1.0 1.0 1.0 1.0" />
  </material>
  <material name="Cyan">
    <color rgba="0.0 1.0 1.0 1.0" />
  </material>
  <link name="agv_base_footprint" />
  <link name="agv_base_link">
    <visual>
      <geometry>
        <box size="1.156 0.922 0.360" />
      </geometry>
      <material name="Grey" />
    </visual>
    <collision>
      <geometry>
        <box size="1.156 0.922 0.360" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="15.0" />
      <inertia ixx="1.180805" ixy="0.0" ixz="0.0" iyy="1.797320" iyz="0.0" izz="2.734805" />
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="agv_base_footprint" />
    <child link="agv_base_link" />
    <origin xyz="0 0 0.270" rpy="0 0 0" />
  </joint>
  <link name="agv_upper_body_link">
    <visual>
      <geometry>
        <box size="0.450 0.415 0.880" />
      </geometry>
      <material name="Grey" />
    </visual>
    <collision>
      <geometry>
        <box size="0.450 0.415 0.880" />
      </geometry>
    </collision>
  </link>
  <joint name="upper_body_joint" type="fixed">
    <parent link="agv_base_link" />
    <child link="agv_upper_body_link" />
    <origin xyz="0 0 0.620" rpy="0 0 0" />
  </joint>
  <link name="agv_robot_arm_mount_link" />
  <joint name="robot_arm_mount_joint" type="fixed">
    <parent link="agv_base_link" />
    <child link="agv_robot_arm_mount_link" />
    <origin xyz="0 0 1.060" rpy="0 0 0" />
  </joint>
  <link name="agv_wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder length="0.055" radius="0.1016" />
      </geometry>
      <material name="Cyan" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder length="0.055" radius="0.1016" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.001425" ixy="0" ixz="0" iyy="0.002652" iyz="0" izz="0.001425" />
    </inertial>
  </link>
  <link name="agv_wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder length="0.055" radius="0.1016" />
      </geometry>
      <material name="Cyan" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder length="0.055" radius="0.1016" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.001425" ixy="0" ixz="0" iyy="0.002652" iyz="0" izz="0.001425" />
    </inertial>
  </link>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="agv_base_link" />
    <child link="agv_wheel_left_link" />
    <origin xyz="0 0.465 -0.1684" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="agv_base_link" />
    <child link="agv_wheel_right_link" />
    <origin xyz="0 -0.465 -0.1684" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <link name="agv_laser_frame">
    <visual>
      <geometry>
        <cylinder length="0.065" radius="0.03" />
      </geometry>
      <material name="Blue" />
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.065" radius="0.03" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.00009006" ixy="0.0" ixz="0.0" iyy="0.00009006" iyz="0.0" izz="0.00009" />
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="agv_base_link" />
    <child link="agv_laser_frame" />
    <origin xyz="0.474 0.000 0.230" rpy="0 0 0" />
  </joint>
  <link name="agv_camera_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.04" />
      </geometry>
      <material name="Black" />
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="agv_base_link" />
    <child link="agv_camera_link" />
    <origin xyz="0.580 0 0.029" rpy="0 0 0" />
  </joint>
  <link name="agv_camera_color_optical_frame" />
  <joint name="agv_camera_color_optical_joint" type="fixed">
    <parent link="agv_camera_link" />
    <child link="agv_camera_color_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
  </joint>
  <link name="agv_imu_link">
    <visual>
      <geometry>
        <box size="0.05 0.10 0.01" />
      </geometry>
      <material name="Brown" />
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.10 0.01" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.02" />
      <inertia ixx="0.00001683" ixy="0.0" ixz="0.0" iyy="0.00000433" iyz="0.0" izz="0.00002083" />
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="agv_base_link" />
    <child link="agv_imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="agv_caster_front_link">
    <visual>
      <geometry>
        <sphere radius="0.05" />
      </geometry>
      <material name="Dark">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
    </inertial>
  </link>
  <joint name="caster_front_joint" type="fixed">
    <parent link="agv_base_link" />
    <child link="agv_caster_front_link" />
    <origin xyz="0.48 0 -0.220" rpy="0 0 0" />
  </joint>
  <link name="agv_caster_rear_link">
    <visual>
      <geometry>
        <sphere radius="0.05" />
      </geometry>
      <material name="Dark">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
    </inertial>
  </link>
  <joint name="caster_rear_joint" type="fixed">
    <parent link="agv_base_link" />
    <child link="agv_caster_rear_link" />
    <origin xyz="-0.48 0 -0.220" rpy="0 0 0" />
  </joint>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.930</wheel_separation>
      <wheel_radius>0.1016</wheel_radius>
      <topic>/model/theimc_agv/cmd_vel</topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_velocity>0.3</max_linear_velocity>
      <min_linear_velocity>-0.3</min_linear_velocity>
      <max_angular_velocity>0.5</max_angular_velocity>
      <min_angular_velocity>-0.5</min_angular_velocity>
      <max_linear_acceleration>0.3</max_linear_acceleration>
      <min_linear_acceleration>-0.3</min_linear_acceleration>
      <max_angular_acceleration>0.5</max_angular_acceleration>
      <min_angular_acceleration>-0.5</min_angular_acceleration>
    </plugin>
  </gazebo>
</robot>