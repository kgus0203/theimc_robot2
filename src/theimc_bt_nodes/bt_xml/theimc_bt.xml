<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <Sequence name="RailTest">

      <!-- 반복 실행 방지용 시작 트리거 -->
      <WaitForMissionTrigger selected_rails="{selected_rails}"/>

      <!-- 레일 진입 -->
      <RailEnter
        enter_tof_mm="130.0"
        settle_sec="2.0"
        rail_velocity="0.3"
        rail_drive_sec="2.0"
        timeout_sec="0.0"
        tof_stale_sec="0.5"/>

      <!-- 레일 탈출 -->
      <PublishRailCommand command="BACK"/>

      <RailExit
        out_tof_mm="140.0"
        timeout_sec="0.0"
        tof_stale_sec="0.5"/>

      <PublishRailCommand command="STOP"/>

    </Sequence>

  </BehaviorTree>
</root>